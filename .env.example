# Loader connection (least-privilege writer; never use a superuser)
LOADER_DATABASE_URL=postgresql://electoral_loader:CHANGE_ME@localhost:5432/electoral?sslmode=prefer
# Optional tuning
TSE_YEARS_GERAL=2026,2022,2018,2014
TSE_YEARS_MUNICIPAL=2024,2020,2016,2012
GEO_QUALITY=intermediaria        # minima | intermediaria | maxima  (IBGE mesh detail)
TSE_IBGE_OVERRIDES=              # optional CSV: cd_municipio,ibge_code
LOADER_TMPDIR=/tmp
